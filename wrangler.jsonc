{
  // Cloudflare Workers deploy for the pre-built Astro `dist/` (static assets only).
  // Deploy with `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yo-mama-jokes",
  "compatibility_date": "2026-07-08",

  "assets": {
    "directory": "./dist",
    // Astro uses `trailingSlash: "never"` — mirror it so `/about/` → `/about`.
    "html_handling": "drop-trailing-slash",
    // Serve dist/404.html with a real HTTP 404 (no soft-404). See MASTER §1/§14.
    "not_found_handling": "404-page"
  },

  // Canonical host = apex. Bind BOTH apex and www to this Worker so both resolve
  // and get certs. www → apex is an edge Redirect Rule (dashboard-only, "Redirect
  // from WWW to root").
  "routes": [
    {
      "pattern": "yomamajokescentral.com",
      "custom_domain": true
    },
    {
      "pattern": "www.yomamajokescentral.com",
      "custom_domain": true
    }
  ]
}
